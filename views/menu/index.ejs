<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Menu - FPSBD Catering</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .table-card { border: none; border-radius: 12px; overflow: hidden; }
        .table thead th { background-color: #212529; color: #fff; font-weight: 500; font-size: 14px; padding: 14px 16px; border: none; }
        .table tbody tr { transition: background 0.15s; }
        .table tbody tr:hover { background-color: #f4faf7; } /* Hover ijo super soft */
        .table tbody td { padding: 13px 16px; vertical-align: middle; font-size: 14px; color: #343a40; border-color: #f0f0f0; }
        
        .badge-harga { background-color: #e6fcf5; color: #0ca678; font-weight: 600; font-size: 13.5px; padding: 6px 12px; border-radius: 8px; display: inline-block; }
        .no-circle { width: 30px; height: 30px; background-color: #dee2e6; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: #495057; }
        
        .btn-edit { background-color: #fff8e1; color: #f59f00; border: 1px solid #ffe08a; border-radius: 8px; font-size: 12px; font-weight: 500; padding: 5px 12px; text-decoration: none; }
        .btn-edit:hover { background-color: #ffe08a; color: #835b00; }
        .btn-hapus { background-color: #fff0f0; color: #e03131; border: 1px solid #ffa8a8; border-radius: 8px; font-size: 12px; font-weight: 500; padding: 5px 12px; text-decoration: none; }
        .btn-hapus:hover { background-color: #ffa8a8; color: #7f1919; }
        
        .page-header { background: white; border-radius: 12px; border: 1px solid #e9ecef; padding: 28px 32px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
        .icon-header { width: 48px; height: 48px; background: #198754; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; margin-right: 14px; }
        .table-footer { border-top: 1px solid #f0f0f0; background: #fafafa; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
    <div class="container">
        <span class="navbar-brand mb-0 h1">
            <i class="bi bi-egg-fried me-2 text-warning"></i> FPSBD Catering Management
        </span>
    </div>
</nav>

<div class="container pb-5">

    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-header bg-success bg-gradient">
                <i class="bi bi-journal-text text-white fs-4"></i>
            </div>
            <div>
                <h2 style="font-size:22px; font-weight:700; margin:0;">Data Menu Makanan</h2>
                <p style="color:#6c757d; margin:4px 0 0; font-size:14px;">Kelola daftar hidangan makanan dan minuman catering</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-secondary d-flex align-items-center gap-1" style="border-radius:8px; font-size:14px;">
                <i class="bi bi-arrow-left"></i> Kembali ke Dashboard
            </a>
            <a href="/menu/create" class="btn btn-success d-flex align-items-center gap-1" style="border-radius:8px; font-size:14px;">
                <i class="bi bi-plus-circle-fill"></i> Tambah Menu
            </a>
        </div>
    </div>

    <div class="card shadow-sm table-card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="width:80px;" class="text-center">No</th>
                        <th>Nama Menu</th>
                        <th>Harga Jual</th>
                        <th style="width:180px; text-align:center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% menu.forEach(function(m, i) { %>
                    <tr>
                        <td class="text-center"><span class="no-circle"><%= i + 1 %></span></td>
                        <td>
                            <span style="font-weight:500;" class="text-dark"><%= m.Nama_Menu %></span>
                        </td>
                        <td>
                            <span class="badge-harga">
                                Rp <%= m.Harga.toLocaleString('id-ID') %>
                            </span>
                        </td>
                        <td style="text-align:center;">
                            <div class="d-flex justify-content-center gap-1">
                                <a href="/menu/edit/<%= m.ID_Menu %>" class="btn btn-edit">
                                    <i class="bi bi-pencil-fill me-1"></i>Edit
                                </a>
                                <a href="/menu/delete/<%= m.ID_Menu %>"
                                   class="btn btn-hapus"
                                   onclick="return confirm('Yakin ingin menghapus menu ini?')">
                                    <i class="bi bi-trash-fill me-1"></i>Hapus
                                </a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (menu.length === 0) { %>
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-text fs-1 d-block mb-2 text-secondary"></i>
                            Belum ada data menu kuliner yang tersimpan.
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="d-flex align-items-center justify-content-between px-4 py-3 table-footer">
            <span style="font-size:13px; color:#868e96;">
                Menampilkan <strong><%= menu.length %></strong> hidangan menu
            </span>
            <span style="font-size:13px; color:#868e96;">
                <i class="bi bi-egg-fried me-1"></i>Total: <%= menu.length %>
            </span>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>