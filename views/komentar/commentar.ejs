<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Komentar Pelanggan - FPSBD Catering</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            background: #f5f5f5;
        }

        .rating-number {
            font-size: 70px;
            font-weight: bold;
        }

        .star-big {
            color: #ffc107;
            font-size: 25px;
        }

        .review-card {
            border: none;
            border-radius: 15px;
        }

        .avatar {
            width: 50px;
            height: 50px;
            background: #343a40;
            color: white;
            border-radius: 50%;
            font-size: 22px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nama-user {
            font-weight: bold;
            font-size: 18px;
        }

        .tanggal {
            font-size: 13px;
            color: gray;
        }

        .filter-btn {
            border-radius: 30px;
        }

        textarea {
            resize: none;
        }
    </style>
</head>

<body>

    <div class="container py-5">

        <!-- HEADER -->
        <div class="d-flex align-items-center mb-4">

            <a href="/" class="text-dark text-decoration-none me-3">
                <i class="bi bi-arrow-left-circle-fill fs-2"></i>
            </a>

            <h2 class="mb-0">
                Ulasan Pelanggan FPSBD Catering
            </h2>

        </div>

        <!-- FORM KOMENTAR -->
        <div class="card shadow-sm mb-5 review-card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Tulis Ulasan
                </h5>
            </div>

            <div class="card-body">

                <form action="/commentar/create" method="POST">

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Nama (Opsional)
                        </label>

                        <input type="text" name="nama" class="form-control" placeholder="Kosongkan jika ingin anonim">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Rating
                        </label>

                        <select name="bintang" class="form-select" required>

                            <option value="">
                                Pilih Rating
                            </option>

                            <option value="5">
                                ⭐⭐⭐⭐⭐
                            </option>

                            <option value="4">
                                ⭐⭐⭐⭐
                            </option>

                            <option value="3">
                                ⭐⭐⭐
                            </option>

                            <option value="2">
                                ⭐⭐
                            </option>

                            <option value="1">
                                ⭐
                            </option>

                        </select>
                    </div>

                    <div class="mb-4">

                        <label class="form-label fw-bold">
                            Komentar
                        </label>

                        <textarea name="komentar" rows="4" class="form-control" placeholder="Tulis pengalaman Anda..."
                            required></textarea>

                    </div>

                    <button class="btn btn-danger px-4">
                        <i class="bi bi-send"></i>
                        Kirim Ulasan
                    </button>

                </form>

            </div>
        </div>

        <!-- STATISTIK -->
        <div class="card shadow-sm mb-5 review-card">
            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 text-center">

                        <div class="rating-number">
                            <%= rata %>
                        </div>

                        <div class="star-big">
                            ⭐⭐⭐⭐⭐
                        </div>

                        <div class="mt-2 text-secondary">
                            <%= totalUlasan %> ulasan
                        </div>

                    </div>

                    <div class="col-md-8">

                        <% for(let i=5;i>=1;i--){ %>

                            <div class="d-flex align-items-center mb-2">

                                <div style="width:20px;">
                                    <%= i %>
                                </div>

                                <div class="progress flex-grow-1 mx-3" style="height:14px;">

                                    <% let persen=totalUlasan ? ((jumlah[i] / totalUlasan) * 100).toFixed(2) : 0; %>

                                        <div class="progress-bar bg-warning" style="width:<%= persen %>%">
                                        </div>

                                </div>

                                <div style="width:40px;">
                                    <%= jumlah[i] %>
                                </div>

                            </div>

                            <% } %>

                    </div>

                </div>

            </div>
        </div>

        <!-- FILTER -->
        <div class="mb-4">

            <a href="/commentar" class="btn btn-outline-dark filter-btn me-2 mb-2">

                Semua
            </a>

            <% for(let i=5;i>=1;i--){ %>

                <a href="/commentar?star=<%= i %>" class="btn btn-outline-warning filter-btn me-2 mb-2">

                    ⭐ <%= i %>

                </a>

                <% } %>

        </div>

        <!-- DAFTAR KOMENTAR -->
        <% if(comments.length===0){ %>

            <div class="alert alert-secondary">
                Belum ada komentar.
            </div>

            <% } %>

                <% comments.forEach(c=> { %>

                    <div class="card shadow-sm mb-4 review-card">

                        <div class="card-body">

                            <div class="d-flex">

                                <!-- AVATAR -->
                                <div class="avatar me-3">
                                    <%= c.nama.charAt(0).toUpperCase() %>
                                </div>

                                <div class="flex-grow-1">

                                    <!-- NAMA -->
                                    <div class="nama-user">
                                        <%= c.nama %>
                                    </div>

                                    <!-- BINTANG -->
                                    <div class="text-warning mb-1" style="font-size:18px;">

                                        <% for(let i=1;i<=c.bintang;i++){ %>
                                            ⭐
                                            <% } %>

                                    </div>

                                    <!-- TANGGAL -->
                                    <div class="tanggal mb-3">

                                        <i class="bi bi-calendar3"></i>

                                        <%= new Date(c.tanggal) .toLocaleDateString( 'id-ID' , { day:'numeric',
                                            month:'long', year:'numeric' } ) %>

                                    </div>

                                    <!-- KOMENTAR -->
                                    <div style="font-size:16px;">
                                        <%= c.komentar %>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <% }) %>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>