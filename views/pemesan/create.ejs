<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tambah Pemesan Baru</h2>
        <a href="/pemesan" class="btn btn-secondary btn-sm">← Kembali</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form action="/pemesan/create" method="POST">
                <div class="mb-3">
                    <label for="nama_pelanggan" class="form-label font-weight-bold">Nama Lengkap Pelanggan</label>
                    <input type="text" id="nama_pelanggan" name="nama_pelanggan" class="form-control" placeholder="Masukkan nama pelanggan" required>
                </div>

                <div class="mb-3">
                    <label for="telepon" class="form-label font-weight-bold">No. HP / Telepon</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                        <input type="text" id="telepon" name="telepon" class="form-control" placeholder="Contoh: 0812XXXXXXXX">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label font-weight-bold">Alamat Email</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="Contoh: pelanggan@email.com">
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <button type="reset" class="btn btn-light me-md-2">Reset</button>
                    <button type="submit" class="btn btn-success">Simpan Pelanggan</button>
                </div>
            </form>
        </div>
    </div>
</div>