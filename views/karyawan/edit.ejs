<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Edit Data Karyawan</h2>
        <a href="/karyawan" class="btn btn-secondary btn-sm">← Kembali</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form action="/karyawan/edit/<%= karyawan.ID_Karyawan %>" method="POST">
                <div class="mb-3">
                    <label for="nama_karyawan" class="form-label font-weight-bold">Nama Karyawan</label>
                    <input type="text" id="nama_karyawan" name="nama_karyawan" value="<%= karyawan.Nama %>" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label for="jabatan" class="form-label font-weight-bold">Jabatan / Posisi</label>
                    <input type="text" id="jabatan" name="jabatan" value="<%= karyawan.Jabatan %>" class="form-control">
                </div>

                <div class="mb-3">
                    <label for="telepon" class="form-label font-weight-bold">No. HP / Telepon</label>
                    <input type="text" id="telepon" name="telepon" value="<%= karyawan.NO_Hp %>" class="form-control">
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <button type="submit" class="btn btn-primary">Update Data</button>
                </div>
            </form>
        </div>
    </div>
</div>