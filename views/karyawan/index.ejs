<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Data Karyawan</h2>
    <div>
        <a href="/" class="btn btn-secondary me-2">← Kembali</a>
        <a href="/karyawan/create" class="btn btn-primary">+ Tambah Karyawan</a>
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>No</th>
            <th>Nama</th>
            <th>Jabatan</th>
            <th>Telepon</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        <% karyawan.forEach(function(k, i) { %>
        <tr>
            <td><%= i + 1 %></td>
            <td><%= k.Nama %></td>
            <td><%= k.Jabatan %></td>
            <td><%= k.NO_Hp %></td>
            <td>
                <a href="/karyawan/edit/<%= k.ID_Karyawan %>" class="btn btn-warning btn-sm">Edit</a>
                <a href="/karyawan/delete/<%= k.ID_Karyawan %>" 
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Yakin hapus karyawan ini?')">Hapus</a>
            </td>
        </tr>
        <% }) %>
        
        <% if (karyawan.length === 0) { %>
        <tr>
            <td colspan="5" class="text-center text-muted">Belum ada data karyawan</td>
        </tr>
        <% } %>
    </tbody>
</table>