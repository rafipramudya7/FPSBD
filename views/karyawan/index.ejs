<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Karyawan - FPSBD Catering</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background-color: #f8f9fa; }
        .table-card { border: none; border-radius: 12px; overflow: hidden; }
        .table thead th { background-color: #212529; color: #fff; font-weight: 500; font-size: 14px; padding: 14px 16px; border: none; }
        .table tbody tr { transition: background 0.15s; }
        .table tbody tr:hover { background-color: #f0f4ff; }
        .table tbody td { padding: 13px 16px; vertical-align: middle; font-size: 14px; color: #343a40; border-color: #f0f0f0; }
        .badge-jabatan { background-color: #e8f0fe; color: #3b5bdb; font-weight: 500; font-size: 12px; padding: 5px 10px; border-radius: 20px; display: inline-block; }
        .no-circle { width: 30px; height: 30px; background-color: #dee2e6; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: #495057; }
        .avatar { width: 34px; height: 34px; border-radius: 50%; background: #dbe4ff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; color: #3b5bdb; }
        .btn-edit { background-color: #fff8e1; color: #f59f00; border: 1px solid #ffe08a; border-radius: 8px; font-size: 12px; font-weight: 500; padding: 5px 12px; }
        .btn-edit:hover { background-color: #ffe08a; color: #835b00; }
        .btn-hapus { background-color: #fff0f0; color: #e03131; border: 1px solid #ffa8a8; border-radius: 8px; font-size: 12px; font-weight: 500; padding: 5px 12px; }
        .btn-hapus:hover { background-color: #ffa8a8; color: #7f1919; }
        .page-header { background: white; border-radius: 12px; border: 1px solid #e9ecef; padding: 28px 32px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.05); }
        .icon-header { width: 48px; height: 48px; background: #4263eb; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; margin-right: 14px; }
        .table-footer { border-top: 1px solid #f0f0f0; background: #fafafa; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
    <div class="container">
        <span class="navbar-brand mb-0 h1">
            <i class="bi bi-egg-fried me-2 text-warning"></i> FPSBD Catering Management
        </span>
    </div>
</nav>

<div class="container pb-5">

    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center">
            <div class="icon-header">
                <i class="bi bi-people-fill text-white fs-4"></i>
            </div>
            <div>
                <h2 style="font-size:22px; font-weight:700; margin:0;">Data Karyawan</h2>
                <p style="color:#6c757d; margin:4px 0 0; font-size:14px;">Kelola data penanggung jawab transaksi catering</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/" class="btn btn-outline-secondary d-flex align-items-center gap-1" style="border-radius:8px; font-size:14px;">
                <i class="bi bi-arrow-left"></i> Kembali
            </a>
            <a href="/karyawan/create" class="btn btn-primary d-flex align-items-center gap-1" style="border-radius:8px; font-size:14px;">
                <i class="bi bi-person-plus-fill"></i> Tambah Karyawan
            </a>
        </div>
    </div>

    <div class="card shadow-sm table-card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th style="width:56px;">No</th>
                        <th>Nama Karyawan</th>
                        <th>Jabatan</th>
                        <th>No. Telepon</th>
                        <th style="width:140px; text-align:center;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% karyawan.forEach(function(k, i) { %>
                    <tr>
                        <td><span class="no-circle"><%= i + 1 %></span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar"><%= k.Nama.substring(0,2).toUpperCase() %></div>
                                <span style="font-weight:500;"><%= k.Nama %></span>
                            </div>
                        </td>
                        <td>
                            <span class="badge-jabatan">
                                <i class="bi bi-briefcase-fill me-1"></i><%= k.Jabatan %>
                            </span>
                        </td>
                        <td>
                            <i class="bi bi-telephone-fill me-1 text-muted" style="font-size:12px;"></i><%= k.NO_Hp %>
                        </td>
                        <td style="text-align:center;">
                            <a href="/karyawan/edit/<%= k.ID_Karyawan %>" class="btn btn-edit me-1">
                                <i class="bi bi-pencil-fill me-1"></i>Edit
                            </a>
                            <a href="/karyawan/delete/<%= k.ID_Karyawan %>"
                               class="btn btn-hapus"
                               onclick="return confirm('Yakin hapus karyawan ini?')">
                                <i class="bi bi-trash-fill me-1"></i>Hapus
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (karyawan.length === 0) { %>
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                            Belum ada data karyawan
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="d-flex align-items-center justify-content-between px-4 py-3 table-footer">
            <span style="font-size:13px; color:#868e96;">
                Menampilkan <strong><%= karyawan.length %></strong> karyawan
            </span>
            <span style="font-size:13px; color:#868e96;">
                <i class="bi bi-people me-1"></i>Total: <%= karyawan.length %>
            </span>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>