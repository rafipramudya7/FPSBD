<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Tagihan Invoice Pemesanan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light p-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-warning shadow-sm bg-white rounded-3">
                <div class="card-header bg-warning text-dark py-3 text-center fw-bold">
                    <h5><i class="bi bi-clock-history"></i> Menunggu Pembayaran</h5>
                </div>
                <div class="card-body p-4">
                    <h5 class="text-center text-muted mb-4">INVOICE #00<%= data.ID_Transaksi %></h5>
                    
                    <table class="table table-borderless align-middle">
                        <tr>
                            <td><strong>Nama Pemesan</strong></td>
                            <td>: <%= data.Nama_Pelanggan %></td>
                        </tr>
                        <tr>
                            <td><strong>Menu Dipesan</strong></td>
                            <td>: <%= data.Nama_Menu %> (<%= data.Jumlah_Porsi %> Porsi)</td>
                        </tr>
                        <tr>
                            <td><strong>Total Tagihan</strong></td>
                            <td>: <span class="text-danger fw-bold fs-5">Rp <%= data.Total_Harga.toLocaleString('id-ID') %></span></td>
                        </tr>
                        <tr>
                            <td><strong>Status Saat Ini</strong></td>
                            <td>: <span class="badge bg-danger"><%= data.Status_Bayar %></span></td>
                        </tr>
                    </table>

                    <form action="/pesanan/pembayaran/<%= data.ID_Transaksi %>" method="POST" class="mt-4">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                                <i class="bi bi-wallet2 me-2"></i> Klik untuk Melunasi Pembayaran
                            </button>
                        </div>
                    </form>

                    <div class="d-grid mt-2">
                        <a href="/" class="btn btn-light text-muted">Bayar Nanti, Kembali ke Beranda</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>