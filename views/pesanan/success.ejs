<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pembayaran Berhasil - FPSBD Catering</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light p-4">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-success shadow rounded-3 bg-white">
                    <div class="card-header bg-success text-white text-center py-3">
                        <h4 class="mb-1"><i class="bi bi-check-circle-fill"></i> Pembayaran Berhasil!</h4>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="text-center text-muted mb-4">INVOICE #00<%= data.ID_Transaksi %></h5>
                        
                        <table class="table table-borderless align-middle">
                            <tr>
                                <td style="width: 40%"><strong>Nama Pemesan</strong></td>
                                <td>: <%= data.Nama_Pelanggan %></td>
                            </tr>
                            <tr>
                                <td><strong>Total Pembayaran</strong></td>
                                <td>: <span class="text-success fw-bold fs-5">Rp <%= data.Total_Harga.toLocaleString('id-ID') %></span></td>
                            </tr>
                            <tr>
                                <td><strong>Status Pembayaran</strong></td>
                                <td>: <span class="badge bg-success fs-6"><%= data.Status_Bayar || 'Lunas' %></span></td>
                            </tr>
                        </table>

                        <div class="alert alert-info text-center mt-4 mb-3">
                            <small class="d-block text-start" style="font-size: 0.875rem;">
                                <i class="bi bi-info-circle-fill me-1"></i> Pembayaran lunas terdeteksi untuk seluruh item menu. Status pengiriman akan diganti menjadi pending
                            </small>
                        </div>

                        <div class="d-grid mt-4">
                            <a href="/" class="btn btn-dark btn-lg fw-bold shadow-sm">
                                <i class="bi bi-speedometer2 me-2"></i> Kembali ke Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>